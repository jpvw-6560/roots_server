/* style.css - NeoGenea */

:root {
  --primary: #2c5f2d;
  --primary-light: #4a9d4f;
  --primary-dark: #1a3a1b;
  --secondary: #8b4513;
  --background: #f5f5f0;
  --surface: #ffffff;
  --text: #333333;
  --text-light: #666666;
  --border: #dddddd;
  --error: #d32f2f;
  --success: #388e3c;
  --shadow: rgba(0, 0, 0, 0.1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: var(--background);
  color: var(--text);
  line-height: 1.6;
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 20px;
}

/* Header */
.header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: white;
  padding: 30px;
  border-radius: 15px;
  text-align: center;
  margin-bottom: 30px;
  box-shadow: 0 4px 6px var(--shadow);
}

.header h1 {
  font-size: 2.5em;
  margin-bottom: 5px;
}

.subtitle {
  font-size: 1.1em;
  opacity: 0.9;
  margin-bottom: 15px;
}

.stats {
  display: flex;
  justify-content: center;
  gap: 30px;
  margin-top: 15px;
  font-size: 0.95em;
}

.stats span {
  background: rgba(255, 255, 255, 0.2);
  padding: 5px 15px;
  border-radius: 20px;
}

/* Navigation */
.nav {
  display: flex;
  gap: 10px;
  margin-bottom: 30px;
  flex-wrap: wrap;
}

.nav-btn {
  flex: 1;
  min-width: 150px;
  padding: 15px 25px;
  border: none;
  background: var(--surface);
  color: var(--text);
  font-size: 1em;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.3s;
  box-shadow: 0 2px 4px var(--shadow);
}

.nav-btn:hover {
  background: var(--primary-light);
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 4px 8px var(--shadow);
}

.nav-btn.active {
  background: var(--primary);
  color: white;
}

/* Content */
.content {
  background: var(--surface);
  padding: 30px;
  border-radius: 15px;
  box-shadow: 0 2px 8px var(--shadow);
  min-height: 500px;
}

.view {
  display: none;
}

.view.active {
  display: block;
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
  flex-wrap: wrap;
  gap: 15px;
}

.toolbar h2 {
  color: var(--primary);
  margin: 0;
}

/* Buttons */
.btn {
  padding: 10px 20px;
  border: none;
  border-radius: 8px;
  font-size: 1em;
  cursor: pointer;
  transition: all 0.3s;
  font-weight: 500;
}

.btn-primary {
  background: var(--primary);
  color: white;
}

.btn-primary:hover {
  background: var(--primary-dark);
  transform: translateY(-2px);
  box-shadow: 0 4px 8px var(--shadow);
}

.btn-secondary {
  background: var(--secondary);
  color: white;
}

.btn-secondary:hover {
  background: #6d3410;
}

.btn-danger {
  background: var(--error);
  color: white;
}

.btn-danger:hover {
  background: #b71c1c;
}

.btn-small {
  padding: 5px 10px;
  font-size: 0.9em;
}

/* Forms */
.form-container {
  max-width: 800px;
  margin: 0 auto;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  margin-bottom: 5px;
  font-weight: 500;
  color: var(--text);
}

.form-control,
input[type="text"],
input[type="date"],
select,
textarea {
  width: 100%;
  padding: 10px;
  border: 2px solid var(--border);
  border-radius: 8px;
  font-size: 1em;
  transition: border-color 0.3s;
}

.form-control:focus,
input:focus,
select:focus,
textarea:focus {
  outline: none;
  border-color: var(--primary);
}

textarea {
  resize: vertical;
  font-family: inherit;
}

.form-actions {
  display: flex;
  gap: 15px;
  margin-top: 30px;
}

/* Persons Grid */
.persons-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
  margin-top: 20px;
}

.person-card {
  background: var(--surface);
  border: 2px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  cursor: pointer;
  transition: all 0.3s;
}

.person-card:hover {
  border-color: var(--primary);
  box-shadow: 0 4px 12px var(--shadow);
  transform: translateY(-3px);
}

.person-card .photo {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  object-fit: cover;
  margin: 0 auto 15px;
  display: block;
  border: 3px solid var(--primary-light);
}

.person-card .name {
  font-size: 1.2em;
  font-weight: bold;
  color: var(--primary);
  text-align: center;
  margin-bottom: 8px;
}

.person-card .info {
  font-size: 0.9em;
  color: var(--text-light);
  text-align: center;
}

.person-card .dates {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
  font-size: 0.85em;
  color: var(--text-light);
}

/* Detail View */
.detail-container {
  max-width: 900px;
  margin: 0 auto;
}

.person-detail-header {
  display: flex;
  gap: 30px;
  margin-bottom: 30px;
  padding-bottom: 20px;
  border-bottom: 2px solid var(--border);
}

.person-detail-photo {
  width: 200px;
  height: 200px;
  border-radius: 15px;
  object-fit: cover;
  border: 4px solid var(--primary-light);
}

.person-detail-info h2 {
  color: var(--primary);
  margin-bottom: 15px;
}

.person-detail-info .info-item {
  margin: 10px 0;
  padding: 8px;
  background: var(--background);
  border-radius: 6px;
}

.person-detail-info .info-label {
  font-weight: 600;
  color: var(--text-light);
  margin-right: 10px;
}

.section {
  margin: 30px 0;
}

.section h3 {
  color: var(--primary);
  margin-bottom: 15px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--primary-light);
}

.relations-list {
  display: grid;
  gap: 15px;
}

.relation-item {
  background: var(--background);
  padding: 15px;
  border-radius: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.relation-item .type {
  display: inline-block;
  padding: 5px 12px;
  background: var(--primary-light);
  color: white;
  border-radius: 15px;
  font-size: 0.85em;
  margin-right: 15px;
}

/* Tree Container */
.tree-container {
  background: var(--background);
  padding: 30px;
  border-radius: 10px;
  min-height: 400px;
  overflow: auto;
}

.tree-node {
  background: var(--surface);
  border: 2px solid var(--primary);
  border-radius: 10px;
  padding: 15px;
  margin: 10px;
  display: inline-block;
  text-align: center;
  min-width: 180px;
}

.tree-node .name {
  font-weight: bold;
  color: var(--primary);
  margin-bottom: 5px;
}

.tree-node .dates {
  font-size: 0.85em;
  color: var(--text-light);
}

/* Search */
.search-container {
  max-width: 900px;
  margin: 0 auto;
}

.search-box {
  display: flex;
  gap: 15px;
  margin-bottom: 30px;
}

.search-box .form-control {
  flex: 1;
}

/* Modal */
.modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  animation: fadeIn 0.3s;
}

.modal.active {
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: var(--surface);
  padding: 30px;
  border-radius: 15px;
  max-width: 500px;
  width: 90%;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
}

.modal-close {
  position: absolute;
  right: 20px;
  top: 20px;
  font-size: 28px;
  font-weight: bold;
  color: var(--text-light);
  cursor: pointer;
}

.modal-close:hover {
  color: var(--text);
}

/* Messages */
.loading,
.info,
.error {
  text-align: center;
  padding: 40px;
  color: var(--text-light);
  font-style: italic;
}

.error {
  color: var(--error);
}

.success-message {
  background: var(--success);
  color: white;
  padding: 15px;
  border-radius: 8px;
  margin-bottom: 20px;
  text-align: center;
}

/* Responsive */
@media (max-width: 768px) {
  .header h1 {
    font-size: 2em;
  }
  
  .stats {
    flex-direction: column;
    gap: 10px;
  }
  
  .nav {
    flex-direction: column;
  }
  
  .nav-btn {
    width: 100%;
  }
  
  .form-row {
    grid-template-columns: 1fr;
  }
  
  .persons-grid {
    grid-template-columns: 1fr;
  }
  
  .person-detail-header {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  
  .toolbar {
    flex-direction: column;
    align-items: stretch;
  }
}
