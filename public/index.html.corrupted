<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NeoGenea - Arbre Généalogique</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="app-container">
    <!-- Header avec menu burger -->
    <header class="header">
      <div class="header-top">
        <button class="burger-menu" id="burger-menu" onclick="toggleMenu()">☰</button>
        <h1>🌳 NeoGenea</h1>
        <div class="header-controls">
          <div class="edit-mode-toggle">
            <label class="switch">
              <input type="checkbox" id="edit-mode" onchange="toggleEditMode()">
              <span class="slider"></span>
            </label>
            <span id="edit-mode-label">🔒 Verrouillé</span>
          </div>
        </div>
      </div>
      <div class="stats" id="stats">
        <span id="stat-persons">0 personnes</span>
        <span id="stat-relations">0 relations</span>
        <span id="stat-medias">0 médias</span>
      </div>
    </header>

    <!-- Navigation latérale -->
    <nav class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <h3>Menu</h3>
        <button class="close-menu" onclick="toggleMenu()">✕</button>
      </div>
      <button class="nav-btn active" data-view="list" onclick="showView('list')">
        <span class="nav-icon">📋</span>
        <span class="nav-text">Liste</span>
      </button>
      <button class="nav-btn" data-view="tree" onclick="showView('tree')">
        <span class="nav-icon">🌳</span>
        <span class="nav-text">Arbre</span>
      </button>
      <buttdiv class="toolbar-controls">
            <div class="view-mode-switch">
              <button class="view-mode-btn active" data-mode="cards" onclick="switchViewMode('cards')">
                <span>🎴</span> Cartes
              </button>
              <button class="view-mode-btn" data-mode="table" onclick="switchViewMode('table')">
                <span>📊</span> Tableau
              </button>
            </div>
            <select id="sort-order" class="form-control" onchange="changeSortOrder()">
              <option value="desc">Plus jeunes d'abord</option>
              <option value="asc">Plus âgés d'abord</option>
            </select>
            <button class="btn btn-primary btn-add" onclick="showView('add')" disabled id="btn-add-list">➕ Ajouter</button>
          </div>
        </div>
        
        <!-- Vue Cartes -->
        <div id="persons-cards" class="persons-grid">
          <p class="loading">Chargement...</p>
        </div>
        
        <!-- Vue Tableau -->
        <div id="persons-table" class="persons-table-container" style="display: none;">
          <table class="persons-table">
            <thead>
              <tr>
                <th>Photo</th>
                <th>Nom</th>
                <th>Prénom</th> complet</h2>
          <div class="toolbar-controls">
            <button class="btn btn-secondary" onclick="zoomOut()">🔍−</button>
            <button class="btn btn-secondary" onclick="zoomIn()">🔍+</button>
            <button class="btn btn-secondary" onclick="resetZoom()">↻ Reset</button>
          </div>
        </div>
        <div id="tree-container" class="tree-container">
          <p class="loading">Chargement de l'arbre...
      <button class="nav-btn" data-view="search" onclick="showView('search')">
        <span class="nav-icon">🔍</span>
        <span class="nav-text">Rechercher</span>
      </button>
    </nav>

    <!-- Overlay pour mobile -->
    <div class="overlay" id="overlay" onclick="toggleMenu()"></div>

    <!-- Main Content -->
    <main class="content">
      <!-- Vue Liste -->
      <div id="view-list" class="view active">
        <div class="toolbar">
          <h2>Liste des personnes</h2>
          <button class="btn btn-primary" onclick="showView('add')">➕ Nouvelle personne</button>
        </div>
        <div id="persons-list" class="persons-grid">
          <p class="loading">Chargement...</p>
        </div>
      </div>

      <!-- Vue Arbre -->
      <div id="view-tree" class="view">
        <div class="toolbar">
          <h2>Arbre généalogique</h2>
          <select id="tree-person-select" class="form-control">
            <option value="">Sélectionner une personne</option>
          </select>
          <select id="tree-type" class="form-control">
            <option value="both">Ascendants et descendants</option>
            <option value="ancestors">Ascendants</option>
            <option value="descendants">Descendants</option>
          </select>
          <button class="btn btn-primary" onclick="generateTree()">Générer l'arbre</button>
        </div>
        <div id="tree-container" class="tree-container">
          <p class="info">Sélectionnez une personne et cliquez sur "Générer l'arbre"</p>
        </div>
      </div>

      <!-- Vue Ajout/Modification -->
      <div id="view-add" class="view">
        <div class="form-container">
          <h2 id="form-title">Ajouter une personne</h2>
          <form id="person-form">
            <input type="hidden" id="person-id" name="id">
            
            <div class="form-row">
              <div class="form-group">
                <label for="nom">Nom *</label>
                <input type="text" id="nom" name="nom" required>
              </div>
              <div class="form-group">
                <label for="prenom">Prénom</label>
                <input type="text" id="prenom" name="prenom">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="nom_jeune_fille">Nom de jeune fille</label>
                <input type="text" id="nom_jeune_fille" name="nom_jeune_fille">
              </div>
              <div class="form-group">
                <label for="sexe">Sexe *</label>
                <select id="sexe" name="sexe" required>
                  <option value="">Sélectionner</option>
                  <option value="M">Masculin</option>
                  <option value="F">Féminin</option>
                  <option value="Autre">Autre</option>
                </select>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group"> id="btn-save-person"
                <label for="date_naissance">Date de naissance</label>
                <input type="date" id="date_naissance" name="date_naissance">
              </div>
              <div class="form-group">
                <label for="lieu_naissance">Lieu de naissance</label>
                <input type="text" id="lieu_naissance" name="lieu_naissance">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="date_deces">Date de décès</label>
                <input type="date" id="date_deces" name="date_deces">
              </div>
              <div class="form-group">
                <label for="lieu_deces">Lieu de décès</label>
                <input type="text" id="lieu_deces" name="lieu_deces">
              </div>
            </div>

            <div class="form-group">
              <label for="biographie">Biographie</label>
              <textarea id="biographie" name="biographie" rows="4"></textarea>
            </div>

            <div class="form-group">
              <label>
                <input type="checkbox" id="vivant" name="vivant" checked>
                Personne vivante
              </label>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
              <button type="button" class="btn btn-secondary" onclick="resetForm(); showView('list');">Annuler</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Vue Recherche -->
      <div id="view-search" class="view">
        <div class="search-container">
          <h2>Rechercher une personne</h2>
          <div class="search-box">
            <input type="text" id="search-input" placeholder="Nom, prénom, lieu..." class="form-control">
            <button class="btn btn-primary" onclick="searchPersons()">🔍 Rechercher</button>
          </div>
          <div id="search-results" class="persons-grid">
            <p class="info">Entrez au moins 2 caractères pour rechercher</p>
          </div>
        </div>
      </div>

      <!-- Vue Détail Personne -->
      <div id="view-detail" class="view">
        <div

      <!-- Message mode verrouillé -->
      <div class="locked-message" id="locked-message" style="display: none;">
        <p>🔒 Mode édition verrouillé. Activez le mode édition pour modifier les données.</p>
      </div> class="detail-container">
          <button class="btn btn-secondary" onclick="showView('list')">← Retour</button>
          <div id="person-detail">
            <p class="loading">Chargement...</p>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Modal pour les relations -->
  <div id="relation-modal" class="modal">
    <div class="modal-content">
      <span class="modal-close" onclick="closeRelationModal()">&times;</span>
      <h2>Ajouter une relation</h2>
      <form id="relation-form">
        <input type="hidden" id="relation-person1" name="person1_id">
        
        <div class="form-group">
          <label for="relation-person2">Personne liée</label>
          <select id="relation-person2" name="person2_id" required>
            <option value="">Sélectionner une personne</option>
          </select>
        </div>

        <div class="form-group">
          <label for="relation-type">Type de relation</label>
          <select id="relation-type" name="type_relation" required>
            <option value="">Sélectionner</option>
            <option value="parent">Parent</option>
            <option value="enfant">Enfant</option>
            <option value="conjoint">Conjoint</option>
            <option value="frere">Frère</option>
            <option value="soeur">Soeur</option>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="relation-date-debut">Date de début</label>
            <input type="date" id="relation-date-debut" name="date_debut">
          </div>
          <div class="form-group">
            <label for="relation-date-fin">Date de fin</label>
            <input type="date" id="relation-date-fin" name="date_fin">
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Ajouter</button>
          <button type="button" class="btn btn-secondary" onclick="closeRelationModal()">Annuler</button>
        </div>
      </form>
    </div>
  </div>

  <script src="app.js"></script>
</body>
</html>
